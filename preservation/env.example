# Secret values are intentionally empty. Populate only in a private .env.local
# or the hosting provider's secret environment settings.
OPENAI_API_KEY=
BOT_TOKEN=
WEBHOOK_AUTH=

# Defaults in the original source; these are not exported Render values.
OPENAI_MODEL=gpt-5.4-mini
PORT=10000

# Optional compressed knowledge, not an API credential.
# Leave empty when knowledge.json is beside server.mjs.
# The original deployed value has not been exported or compared.
KNOWLEDGE_GZIP_B64=
